# ---------------------------------------------------------------------------
# PrimeDollars Edge — environment variables (NAMES ONLY, no secrets)
# Copy to .env and fill in locally. Never commit a real .env file.
# ---------------------------------------------------------------------------

# --- Frontend (build-time / public) ---------------------------------------
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DERIV_APP_ID=
# Existing build reads this at build time (currently inlined in the bundle):
NEXT_PUBLIC_BOT_HUB_API_URL=

# --- Backend only (never expose to the browser) ---------------------------
DERIV_APP_ID=
DERIV_API_TOKEN=
DATABASE_URL=
JWT_SECRET=
ENCRYPTION_KEY=
